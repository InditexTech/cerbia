{
  "schemaVersion": 1,
  "origin": "https://inditextech.github.io",
  "siteUrl": "https://inditextech.github.io/cerbia",
  "basePath": "/cerbia/",
  "artifactRoot": "docs/build/site",
  "artifactMount": "/cerbia/",
  "component": "ROOT",
  "startPage": "ROOT::index.adoc",
  "marketingPage": "ROOT:index.adoc",
  "docsIndexPage": "main:about",
  "urlStyle": "indexify",
  "versioning": {
    "mode": "standalone",
    "branchSelector": "main",
    "tagSelector": "docs/stable",
    "prereleaseDescriptor": { "version": "prerelease", "prerelease": true },
    "stableDescriptor": { "version": "stable", "prerelease": false },
    "absentStable": { "versions": ["prerelease"], "legacyTargetVersion": "prerelease" },
    "presentStable": { "versions": ["prerelease", "stable"], "legacyTargetVersion": "stable" },
    "codeTagPattern": "v*",
    "codeTagDocsVersion": false,
    "latestVersionSegment": null
  },
  "paths": {
    "marketingRoot": { "url": "/cerbia/", "output": "index.html", "role": "site start-page entry to the ROOT marketing home" },
    "prereleaseMarketing": { "url": "/cerbia/prerelease/", "output": "prerelease/index.html" },
    "stableMarketing": { "url": "/cerbia/stable/", "output": "stable/index.html" },
    "prereleaseDocsIndex": { "url": "/cerbia/prerelease/main/about/", "output": "prerelease/main/about/index.html", "pageId": "main:about" },
    "stableDocsIndex": { "url": "/cerbia/stable/main/about/", "output": "stable/main/about/index.html", "pageId": "main:about" },
    "prereleaseComponentTopic": { "url": "/cerbia/prerelease/main/components/scanners/keyword/", "output": "prerelease/main/components/scanners/keyword/index.html", "pageId": "main:components/scanners/keyword" },
    "stableComponentTopic": { "url": "/cerbia/stable/main/components/scanners/keyword/", "output": "stable/main/components/scanners/keyword/index.html", "pageId": "main:components/scanners/keyword" },
    "prereleasePackageTopic": { "url": "/cerbia/prerelease/cerbia-core/", "output": "prerelease/cerbia-core/index.html", "pageId": "cerbia-core:index" },
    "stablePackageTopic": { "url": "/cerbia/stable/cerbia-core/", "output": "stable/cerbia-core/index.html", "pageId": "cerbia-core:index" },
    "oldDocsIndexAlias": { "url": "/cerbia/docs/", "output": "docs/index.html", "pageId": "main:about" }
  },
  "legacyAliases": [
    "/cerbia/docs/architecture/",
    "/cerbia/docs/cli/",
    "/cerbia/docs/components/custom-components/",
    "/cerbia/docs/components/loaders/file-loader/",
    "/cerbia/docs/components/loaders/",
    "/cerbia/docs/components/loaders/text-loader/",
    "/cerbia/docs/components/preprocessors/",
    "/cerbia/docs/components/preprocessors/speculative-decoding/",
    "/cerbia/docs/components/preprocessors/whitespace-normalization/",
    "/cerbia/docs/components/scanners/canary-leak/",
    "/cerbia/docs/components/scanners/",
    "/cerbia/docs/components/scanners/invisible-text/",
    "/cerbia/docs/components/scanners/keyword/",
    "/cerbia/docs/components/scanners/pii-presidio/",
    "/cerbia/docs/components/scanners/pii/",
    "/cerbia/docs/components/scanners/prompt-injection-protectai/",
    "/cerbia/docs/components/scanners/prompt-injection/",
    "/cerbia/docs/components/scanners/secrets/",
    "/cerbia/docs/components/scanners/url-allowlist/",
    "/cerbia/docs/components/scanners/url-malicious/",
    "/cerbia/docs/components/scanners/xss/",
    "/cerbia/docs/components/score-aggregators/",
    "/cerbia/docs/components/score-aggregators/max-with-bonus/",
    "/cerbia/docs/components/score-aggregators/max/",
    "/cerbia/docs/components/score-aggregators/mean/",
    "/cerbia/docs/configuration/",
    "/cerbia/docs/gate/",
    "/cerbia/docs/getting-started/",
    "/cerbia/docs/i18n/",
    "/cerbia/docs/",
    "/cerbia/docs/logging/",
    "/cerbia/docs/packages/cerbia-cli/",
    "/cerbia/docs/packages/cerbia-core/",
    "/cerbia/docs/packages/cerbia-ml/",
    "/cerbia/docs/packages/cerbia-presidio/",
    "/cerbia/docs/packages/cerbia-protectai/",
    "/cerbia/docs/packages/cerbia/",
    "/cerbia/docs/packages/"
  ],
  "legacyPolicy": {
    "entry": "one static index.html per alias below the artifact root; no hosting-level redirect",
    "variants": ["trailing-slash", "slashless", "index.html"],
    "slashlessCaveat": "Pages directory resolution must be checked against a Pages-equivalent server; a non-redirecting local server only proves the emitted index.html and slash URL",
    "target": "resolve each legacy route via legacy-routes.json redirectTarget against the selected version; unknown routes have no entry and return 404",
    "withJavaScript": "append location.search and location.hash unchanged to the selected canonical target URL",
    "withoutJavaScript": "visible link and noscript link to selected canonical target; query and fragment forwarding requires JavaScript"
  },
  "publication": {
    "release": "separate intentional docs release creates or moves docs/stable with version stable; never triggered by code v* tags",
    "events": ["push:main with docs-relevant paths", "push:docs/stable", "optional push:v* republish only"],
    "codeTagAction": "fetch actual main and docs/stable refs and rebuild their descriptors; never aggregate v* as a docs version",
    "pagesConcurrencyGroup": "cerbia-docs-pages",
    "cancelInProgress": false,
    "uploadAction": "actions/upload-pages-artifact",
    "deployAction": "actions/deploy-pages",
    "noStableFallback": "publish prerelease only and target all 38 legacy aliases at prerelease; never fail because docs/stable is absent"
  },
  "fixtureBuildConfirmation": "deferred to task 4: confirm generated output and adjust this expected table before generating aliases"
}
