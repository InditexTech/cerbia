{
  "name": "cerbia",
  "version": "1.0.0",
  "private": true,
  "description": "CerbIA documentation, built with Antora",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.8.0",
  "scripts": {
    "dev": "docouture dev",
    "build": "antora --fetch --log-failure-level warn antora-playbook.yml && node scripts/fix-search-index.mjs",
    "check-links": "node scripts/check-links.mjs"
  },
  "devDependencies": {
    "@inditextech/docouture-cli": "1.1.1",
    "@inditextech/docouture-ui-bundle": "1.1.1",
    "@inditextech/docouture-asciidoc-extensions": "1.1.1",
    "@inditextech/docouture-antora-extensions": "1.1.1",
    "@inditextech/docouture-publish-gh-pages": "1.1.1",
    "antora": "3.2.0",
    "linkinator": "8.0.4"
  },
  "docouture": {
    "branching": "trunk-based",
    "publish": {
      "gh-pages": {}
    },
    "checkLinks": {
      "ignore": [
        "*/edit/HEAD/*",
        "https://github.com/InditexTech/cerbia"
      ]
    }
  }
}
