{
  "name": "cerbia",
  "version": "1.0.0",
  "private": true,
  "description": "CerbIA documentation, built with Antora",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.8.0",
  "scripts": {
    "dev": "docouture dev",
    "build": "antora --fetch --log-failure-level warn antora-playbook.yml"
  },
  "devDependencies": {
    "@inditextech/docouture-cli": "1.3.1",
    "@inditextech/docouture-ui-bundle": "1.3.1",
    "@inditextech/docouture-asciidoc-extensions": "1.3.1",
    "@inditextech/docouture-antora-extensions": "1.3.1",
    "@inditextech/docouture-publish-gh-pages": "1.3.1",
    "antora": "3.2.0"
  },
  "docouture": {
    "branching": "trunk-based",
    "publish": {
      "gh-pages": {}
    }
  }
}
